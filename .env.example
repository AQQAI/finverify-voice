# Speech (recommended for Hindi). Also used as the LLM if LLM_API_KEY is empty.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=

# Optional LLM, only for questions with no matching fact (numbers are firewalled)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# finverify checks numbers an LLM writes: off | http | python
FINVERIFY_MODE=off
FINVERIFY_URL=http://localhost:9000/check

# Shared secret Bolna sends as "Bearer <token>"
BOLNA_TOKEN=

# Optional: pretend today is this date (to demo stale-fact handling)
FV_TODAY=

# Outbound calls ("call me now" / "call me when rates change") via Bolna's POST /call
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
